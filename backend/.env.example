PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
NODE_ENV=development

# Long random string (at least 32 bytes), used to sign refresh tokens (HS256)
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret

# Paths to the RS256 key pair. Keep the private key out of git and out of the frontend.
ACCESS_TOKEN_PRIVATE_KEY_PATH=./keys/access-token-private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=./keys/access-token-public.pem
